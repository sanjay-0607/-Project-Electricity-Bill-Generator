#BILLINGAPPUI SCREEN(FUNCTION)
@Composable
fun BillingAppUI(innerPadding: PaddingValues) {
    val scrollState = rememberScrollState()
    var sanctionedLoad by remember { mutableStateOf(TextFieldValue("")) }
    var entitlementUnits by remember { mutableStateOf(TextFieldValue("")) }
    var consumedUnits by remember { mutableStateOf(TextFieldValue("")) }
    var recordedLoad by remember { mutableStateOf(TextFieldValue("")) }

    // Results
    var totalAmount by remember { mutableStateOf("") }
    var gruhajyothiTotal by remember { mutableStateOf("") }
    var finalAmount by remember { mutableStateOf("") }
    var resultDetails by remember { mutableStateOf<Map<String, String>>(emptyMap()) }

    // UI Layout
    Column(
        modifier = Modifier
            .fillMaxSize()
            .background(Color(0xFFEFEFEF)) // Light gray background
            .padding(innerPadding)
            .padding(16.dp)
            .verticalScroll(scrollState),
        horizontalAlignment = Alignment.CenterHorizontally
    ) {


        Spacer(modifier = Modifier.height(16.dp))

        Text(
            "Bill Calculator",
            style = MaterialTheme.typography.headlineSmall.copy(fontSize = 24.sp),
            color = Color(0xFF37474F),
            textAlign = TextAlign.Center
        )
        Spacer(modifier = Modifier.height(16.dp))

        // Input fields
        InputCard(label = "Sanctioned Load",img = R.drawable.sanctioned_load ,  value = sanctionedLoad) { sanctionedLoad = it }
        InputCard(label = "Entitlement Units",img = R.drawable.entilelment_units ,  value = entitlementUnits) { entitlementUnits = it }
        InputCard(label = "Consumed Units",img = R.drawable.consumed_load  ,  value = consumedUnits) { consumedUnits = it }
        InputCard(label = "Recorded Load", img = R.drawable.recorded_load  , value = recordedLoad) { recordedLoad = it }

        Spacer(modifier = Modifier.height(16.dp))

        // Calculate button
        Button(
            onClick = {
                val sl = sanctionedLoad.text.toDoubleOrNull() ?: 0.0
                val eu = entitlementUnits.text.toDoubleOrNull() ?: 0.0
                val cu = consumedUnits.text.toDoubleOrNull() ?: 0.0
                val rl = recordedLoad.text.toDoubleOrNull() ?: 0.0

                val results = calculateBill(sl, eu, cu, rl)
                resultDetails = results
                totalAmount = "Total: ${results["total"]}"
                gruhajyothiTotal = "GRUHA JYOTHI SUBSIDY: ${results["gruhajyothi"]}"
                finalAmount = "Final Amount to be Paid: ${results["finalAmount"]}"
            },
            shape = RoundedCornerShape(12.dp),
            colors = ButtonDefaults.buttonColors(containerColor = Color(0xFF4CAF50))
        ) {
            Text("Calculate", color = Color.White)
        }

        Spacer(modifier = Modifier.height(16.dp))

        // Results Section
        if (resultDetails.isNotEmpty()) {
            ResultCard(
                title = "Calculation Result",
                fixedCharge = resultDetails["fixedCharge"]!!,
                energyCharges = resultDetails["energyCharges"]!!,
                fppca = resultDetails["fppca"]!!,
                tax = resultDetails["tax"]!!,
                total = resultDetails["total"]!!,
                gruhajyothi = resultDetails["gruhajyothi"]!!,
                excessLoadCharge = resultDetails["excessLoad"]!!,
                finalAmount = resultDetails["finalAmount"]!!
            )
        }
    }
}

// Input Card with Label and Hint
@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun InputCard(
    label: String,
    value: TextFieldValue,
    img : Int ,
    onValueChange: (TextFieldValue) -> Unit
) {
    var isExpanded by remember { mutableStateOf(false) }

    Card(
        modifier = Modifier
            .fillMaxWidth()
            .padding(vertical = 8.dp),
        colors = CardDefaults.cardColors(containerColor = Color.White),
        elevation = CardDefaults.cardElevation(4.dp)
    ) {
        Column(
            modifier = Modifier.padding(16.dp),
            horizontalAlignment = Alignment.CenterHorizontally
        ) {
            Row(
                modifier = Modifier.fillMaxWidth(),
                verticalAlignment = Alignment.CenterVertically
            ) {
                Text(
                    label,
                    style = MaterialTheme.typography.labelLarge.copy(color = Color.Gray),
                    modifier = Modifier.weight(1f)
                )
                IconButton(onClick = { isExpanded = !isExpanded }) {
                    Icon(
                        imageVector = if (isExpanded) Icons.Default.KeyboardArrowUp else Icons.Default.KeyboardArrowDown,
                        contentDescription = if (isExpanded) "Collapse" else "Expand"
                    )
                }
            }

            if (isExpanded) {
                Spacer(modifier = Modifier.height(8.dp))
                Image(
                    painter = painterResource(img), // Replace with your image resource
                    contentDescription = "Sample Image",
                    modifier = Modifier
                        .fillMaxWidth()
                        .padding(8.dp)
                        .wrapContentHeight(),
                    contentScale = ContentScale.Fit // Use ContentScale.FillBounds if stretching is preferred
                )

            }

            Spacer(modifier = Modifier.height(8.dp))
            TextField(
                value = value,
                onValueChange = onValueChange,
                placeholder = { Text("Enter $label", color = Color(0xFF37474F)) },
                singleLine = true,
                keyboardOptions = KeyboardOptions(imeAction = ImeAction.Done),
                colors = TextFieldDefaults.textFieldColors(
                    containerColor = Color(0xFFF7F7F7),
                    focusedIndicatorColor = Color(0xFF4CAF50),
                    focusedTextColor = Color.Black,
                    unfocusedTextColor = Color.Black,
                    unfocusedIndicatorColor = Color.Gray
                )
            )
        }
    }
}


