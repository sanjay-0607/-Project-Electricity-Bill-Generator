// Calculation Logic
fun calculateBill(
    sanctionedLoad: Double,
    entitlementUnit: Double,
    consumedUnit: Double,
    recordedLoad: Double
): Map<String, String> {
    val fixedCharge = 120 * sanctionedLoad
    val energyCharges = consumedUnit * 5.90
    val fppca = consumedUnit * 0.3
    val tax = (energyCharges / 100) * 9
    val total = fixedCharge + energyCharges + fppca + tax

    val gruhajyothiFixedCharge = if (entitlementUnit == 0.0) 0.0 else 120 * sanctionedLoad
    val gruhajyothiEnergyCharges = entitlementUnit * 5.90
    val gruhajyothiFppca = entitlementUnit * 0.3
    val gruhajyothiTax = (gruhajyothiEnergyCharges / 100) * 9
    val gruhajyothiTotal = gruhajyothiFixedCharge + gruhajyothiEnergyCharges + gruhajyothiFppca + gruhajyothiTax

    val excessLoad = if (recordedLoad > sanctionedLoad) (recordedLoad - sanctionedLoad) * 186.0 else 0.0
    val finalAmount = total - gruhajyothiTotal + excessLoad

    return mapOf(
        "fixedCharge" to String.format("%.2f", fixedCharge),
        "energyCharges" to String.format("%.2f", energyCharges),
        "fppca" to String.format("%.2f", fppca),
        "tax" to String.format("%.2f", tax),
        "total" to String.format("%.2f", total),
        "gruhajyothi" to String.format("%.2f", gruhajyothiTotal),
        "excessLoad" to String.format("%.2f", excessLoad),
        "finalAmount" to String.format("%.2f", finalAmount)
    )
}
